{ ... }:

{
  # ============================================================
  # PATH
  # ============================================================

  home.sessionPath = [
    "$HOME/.local/bin"
    "$HOME/.dotnet/tools"
  ];


  # ============================================================
  # BASH
  # ============================================================

  programs.bash = {
    enable = true;

    enableCompletion = true;


    shellAliases = {
      # --------------------------------------------------------
      # FILES
      # --------------------------------------------------------

      ll =
        "eza -lah --group-directories-first";

      cat =
        "bat --paging=never";


      # --------------------------------------------------------
      # GIT
      # --------------------------------------------------------

      gs =
        "git status";

      lg =
        "lazygit";


      # --------------------------------------------------------
      # DOCKER
      # --------------------------------------------------------

      dc =
        "docker compose";

      dps =
        "docker ps";

      lzd =
        "lazydocker";


      # --------------------------------------------------------
      # .NET
      # --------------------------------------------------------

      dotnets =
        "dotnet --list-sdks";


      # --------------------------------------------------------
      # PYTHON
      # --------------------------------------------------------

      py =
        "python";

      venv =
        "python -m venv .venv";


      # --------------------------------------------------------
      # NIXOS
      # --------------------------------------------------------

      nrs =
        "nh os switch";

      nrb =
        "nh os build";

      nrt =
        "nh os test";


      # --------------------------------------------------------
      # FORMAT / LINT NIX
      # --------------------------------------------------------

      nixfmtall =
        "sudo alejandra /etc/nixos";

      nixlint =
        "statix check /etc/nixos && deadnix /etc/nixos";


      # --------------------------------------------------------
      # JOURNAL
      # --------------------------------------------------------

      jerr =
        "journalctl -p err -b";

      jboot =
        "journalctl -b";

      jfollow =
        "journalctl -f";


      # --------------------------------------------------------
      # BACKUP
      # --------------------------------------------------------

      backup-now =
        "sudo systemctl start restic-backups-nixos.service";

      backup-status =
        "systemctl status restic-backups-nixos.service --no-pager";


      # --------------------------------------------------------
      # GLOBALPROTECT
      # --------------------------------------------------------

      gp =
        "gpclient";
    };


    # ==========================================================
    # NVM
    # ==========================================================

    initExtra = ''
      export NVM_DIR="$HOME/.nvm"

      if [ -s "$NVM_DIR/nvm.sh" ]; then
        . "$NVM_DIR/nvm.sh"
      fi

      if [ -s "$NVM_DIR/bash_completion" ]; then
        . "$NVM_DIR/bash_completion"
      fi


      # ========================================================
      # .NET GLOBAL TOOLS
      # ========================================================

      export PATH="$HOME/.dotnet/tools:$PATH"
    '';
  };


  # ============================================================
  # DIRENV
  # ============================================================

  programs.direnv = {
    enable = true;

    enableBashIntegration = true;

    nix-direnv.enable = true;
  };
}